<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="Новая задача…"
        android:textColor="@color/mw_muted"
        android:textSize="16sp" />
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_plus_bg"
        android:contentDescription="Добавить задачу"
        android:padding="12dp"
        android:src="@drawable/widget_plus" />
</LinearLayout>
