<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:baselineAligned="true"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/mw_ink"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/mw_soft"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/w_row0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/w_chk0"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="-10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/widget_chk" />
            <TextView
                android:id="@+id/w_title0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/mw_ink"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/w_meta0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/mw_soft"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/w_chk1"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="-10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/widget_chk" />
            <TextView
                android:id="@+id/w_title1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/mw_ink"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/w_meta1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/mw_soft"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/w_chk2"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="-10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/widget_chk" />
            <TextView
                android:id="@+id/w_title2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/mw_ink"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/w_meta2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/mw_soft"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/w_chk3"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="-10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/widget_chk" />
            <TextView
                android:id="@+id/w_title3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/mw_ink"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/w_meta3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/mw_soft"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/w_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/mw_muted"
        android:textSize="13sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:textColor="@color/mw_soft"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
